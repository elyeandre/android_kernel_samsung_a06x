# MT76x2U firmware — let the kernel read it from the module dir in ENFORCING mode.
#
# The kernel firmware loader (u:r:kernel:s0) reads mt7662*.bin directly from the
# path in firmware_class.path. Files under /data/adb are not a type the kernel may
# read by default (the exact denial seen on-device was kernel vs shell_data_file
# for firmware under /data). service.sh relabels our firmware to
# vendor_firmware_file (which the kernel already reads); these rules permit that
# relabel and also cover the case where it does not stick.
#
# Tune against `dmesg | grep avc` if your device reports a different type.

# read firmware whichever type it ends up with
allow kernel vendor_firmware_file file { open read getattr }
allow kernel adb_data_file file { open read getattr }

# The kernel must also TRAVERSE every directory on the way to the file, not just
# read the file itself. Missing these is why the load failed with -13 (EACCES)
# while `setenforce 0` worked:
#   /data                                    -> system_data_file
#   /data/adb/modules/<id>/firmware/         -> adb_data_file
# Note the chcon in service.sh relabels the FILES; the parent directories keep
# their own type, so both are needed.
allow kernel system_data_file dir search
allow kernel adb_data_file dir { search open read getattr }
allow kernel vendor_firmware_file dir { search open read getattr }
# manual flow: firmware staged in /data/local/tmp/firmware (shell_data_file).
# This is the denial seen on-device with `setenforce 0` as the workaround.
allow kernel shell_data_file file { open read getattr }
allow kernel shell_data_file dir { search open read }

# permit service.sh's chcon (relabel) to vendor_firmware_file
allow init adb_data_file file relabelfrom
allow init vendor_firmware_file file relabelto
