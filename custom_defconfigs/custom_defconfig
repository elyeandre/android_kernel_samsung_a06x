# disable samsung anti-root stuffs
CONFIG_SECURITY_DEFEX=n

# KernelSU-Next
CONFIG_KSU=y

# Droidspaces GKI support (kABI-safe with sched.h patch)

# IPC
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y

# Namespaces
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_USER_NS=y

# HW Access Support
CONFIG_DEVTMPFS=y

# Docker NAT
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y

# UFW
CONFIG_NETFILTER_XT_TARGET_REJECT=y
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_NETFILTER_XT_MATCH_RECENT=y

# Fail2ban
CONFIG_IP_SET=y
CONFIG_IP_SET_HASH_IP=y
CONFIG_IP_SET_HASH_NET=y
CONFIG_NETFILTER_XT_SET=y

# MTK connectivity modules (build from vendor source, not EXT_MODULES)
CONFIG_WLAN_DRV_MODULE=y
CONFIG_MTK_BT_DRV_EXTERNAL=y
CONFIG_MTK_GPS_DRV_EXTERNAL=y
CONFIG_MTK_FM_DRV_EXTERNAL=y

# MediaTek MT76x2U USB Wi-Fi — MT7612U 802.11ac dongles
# Gate: stock config has WLAN_VENDOR_MEDIATEK off, which hides the whole mt76
# Kconfig — must re-enable it or CONFIG_MT76x2U is silently dropped.
CONFIG_WLAN_VENDOR_MEDIATEK=y
# Must be =m: it depends on MAC80211, which is =m (a built-in can't depend on a module).
# Auto-selects (via kconfig): MT76x2_COMMON, MT76x02_LIB, MT76_CORE, MT76x02_USB, MT76_USB
CONFIG_MT76x2U=m
